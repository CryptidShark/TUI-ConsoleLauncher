<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/gestures_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● [ GESTURES CONFIGURATION ]"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Swipe Up"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tv_swipe_up_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="App Drawer (apps -ls)"
        android:textSize="14sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Swipe Down"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tv_swipe_down_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notifications (notifications)"
        android:textSize="14sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Double Tap"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tv_double_tap_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lock Device (double_tap_lock)"
        android:textSize="14sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Long Press"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tv_long_press_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Launcher Settings / Item Options"
        android:textSize="14sp"
        android:layout_marginTop="2dp" />

</LinearLayout>
